'use strict';

const API_BASE = typeof window !== 'undefined'
  ? (window.apiBase || window.location.origin)
  : '';

const DEFAULT_TIMEOUT_MS = 15000;

const R = Object.freeze({
  base: '/api/products',
  byCode: (productCode) => `/api/products/${encodeURIComponent(productCode)}`,
  exportExcel: '/api/products/exportar/excel',
  uploadImage: (productCode) => `/api/products/${encodeURIComponent(productCode)}/imagem`,
  registros: (productCode) => `/api/products/${encodeURIComponent(productCode)}/registros`,
  images: '/api/products-imagens',
  imagesByProduct: (productCode) =>
    `/api/products-imagens/product/${encodeURIComponent(productCode)}`,
  primaryImage: (productCode) =>
    `/api/products-imagens/product/${encodeURIComponent(productCode)}/primary`,
});

// Colunas removidas da tabela principal. Elas vivem em tabelas filhas ou não
// fazem mais parte do modelo. O cliente nunca deve reenviá-las ao CRUD central.
const REMOVED_PRODUCT_FIELDS = new Set([
  'product_price_id',
  'product_grade_id',
  'product_unit_id',
  'product_dimension_id',
  'products_fiscal_id',
  'tax_icms_sale_percent',
  'tax_pis_sale_percent',
  'tax_cofins_sale_percent',
  'tax_icms_st_value',
  'tax_ipi_value',
  'show_on_ecommerce_home',
]);

function sanitizeProductPayload(payload = {}) {
  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return {};

  return Object.fromEntries(
    Object.entries(payload).filter(([key]) => !REMOVED_PRODUCT_FIELDS.has(key)),
  );
}

async function http(
  path,
  { method = 'GET', headers = {}, body, timeout = DEFAULT_TIMEOUT_MS } = {},
) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeout);
  const opts = { method, headers: { ...headers }, signal: controller.signal };

  if (body instanceof FormData) {
    opts.body = body;
  } else if (body !== undefined) {
    opts.body = JSON.stringify(body);
    opts.headers['Content-Type'] = 'application/json';
  }

  try {
    const res = await fetch(`${API_BASE}${path}`, opts);
    if (!res.ok) {
      let message = `HTTP ${res.status}`;
      try {
        const data = await res.json();
        if (data?.error) message += ` — ${data.error}`;
        if (data?.details) message += ` (${data.details})`;
      } catch {
        // Resposta sem JSON.
      }
      throw new Error(message);
    }

    const contentType = res.headers.get('content-type') || '';
    return contentType.includes('application/json') ? res.json() : res;
  } finally {
    clearTimeout(timer);
  }
}

function requiredProductCode(value) {
  const code = String(value ?? '').trim();
  if (!code) throw new Error('product_code inválido.');
  return code;
}

function positiveInteger(value, label) {
  const id = Number(value);
  if (!Number.isInteger(id) || id <= 0) throw new Error(`${label} inválido.`);
  return id;
}

function optionalBarcodeId(value) {
  if (value === null || value === undefined || value === '') return null;
  return positiveInteger(value, 'barcode_id');
}

export async function listProducts({ page = 1, limit = 20, q = '', ...filters } = {}) {
  const params = new URLSearchParams();
  if (page != null) params.set('page', String(page));
  if (limit != null) params.set('limit', String(limit));
  if (q && String(q).trim()) params.set('q', String(q).trim());

  for (const [key, value] of Object.entries(filters)) {
    if (value !== undefined && value !== null && value !== '') {
      params.set(key, String(value));
    }
  }

  const query = params.toString();
  return http(`${R.base}${query ? `?${query}` : ''}`);
}

export async function getProductByCode(productCode) {
  return http(R.byCode(requiredProductCode(productCode)));
}

export async function createProduct(payload = {}) {
  return http(R.base, {
    method: 'POST',
    body: sanitizeProductPayload(payload),
  });
}

export async function updateProductByCode(productCode, payload = {}) {
  return http(R.byCode(requiredProductCode(productCode)), {
    method: 'PUT',
    body: sanitizeProductPayload(payload),
  });
}

export async function deleteProductByCode(productCode) {
  return http(R.byCode(requiredProductCode(productCode)), { method: 'DELETE' });
}

// Aliases temporários para módulos que ainda não renomearam seus imports.
export const getProductById = getProductByCode;
export const updateProductById = updateProductByCode;
export const deleteProductById = deleteProductByCode;

export async function uploadProductImage(
  productCode,
  barcodeId,
  file,
  { imageAlt = '', isPrimary = false } = {},
) {
  const code = requiredProductCode(productCode);
  const unitId = optionalBarcodeId(barcodeId);
  if (!(file instanceof File || file instanceof Blob)) throw new Error('Arquivo inválido.');

  const form = new FormData();
  form.append('file', file);
  form.append('product_code', code);
  if (unitId !== null) form.append('barcode_id', String(unitId));
  form.append('imageAlt', String(imageAlt || ''));
  form.append('is_primary', String(Boolean(isPrimary)));

  return http(R.uploadImage(code), { method: 'POST', body: form });
}

export async function listProductImages(productCode, { barcodeId, onlyActive = true } = {}) {
  const code = requiredProductCode(productCode);
  const params = new URLSearchParams({ onlyActive: String(Boolean(onlyActive)) });
  if (barcodeId !== undefined) {
    const unitId = optionalBarcodeId(barcodeId);
    params.set('barcode_id', unitId === null ? '' : String(unitId));
  }
  return http(`${R.imagesByProduct(code)}?${params.toString()}`);
}

export async function getPrimaryProductImage(productCode, barcodeId = undefined) {
  const code = requiredProductCode(productCode);
  const params = new URLSearchParams();
  if (barcodeId !== undefined) {
    const unitId = optionalBarcodeId(barcodeId);
    params.set('barcode_id', unitId === null ? '' : String(unitId));
  }
  const query = params.toString();
  return http(`${R.primaryImage(code)}${query ? `?${query}` : ''}`);
}

export async function updateProductImage(productImageId, payload = {}) {
  const id = positiveInteger(productImageId, 'product_image_id');
  return http(`${R.images}/${id}`, { method: 'PATCH', body: payload });
}

export async function setPrimaryProductImage(productImageId, productCode, barcodeId = null) {
  const id = positiveInteger(productImageId, 'product_image_id');
  return http(`${R.images}/${id}/primary`, {
    method: 'PATCH',
    body: {
      product_code: requiredProductCode(productCode),
      barcode_id: optionalBarcodeId(barcodeId),
    },
  });
}

export async function reorderProductImages(productCode, barcodeId, orderedIds = []) {
  const code = requiredProductCode(productCode);
  if (!Array.isArray(orderedIds) || !orderedIds.length) {
    throw new Error('orderedIds deve ser um array não vazio.');
  }

  return http(`${R.imagesByProduct(code)}/reorder`, {
    method: 'PATCH',
    body: { barcode_id: optionalBarcodeId(barcodeId), orderedIds },
  });
}

export async function deleteProductImage(productImageId, { hard = false } = {}) {
  const id = positiveInteger(productImageId, 'product_image_id');
  return http(`${R.images}/${id}?hard=${String(Boolean(hard))}`, { method: 'DELETE' });
}

export async function exportExcel() {
  const res = await fetch(`${API_BASE}${R.exportExcel}`);
  if (!res.ok) throw new Error(`HTTP ${res.status} — falha ao exportar Excel`);
  return res.blob();
}

export async function getCostMapByCodes(codes = []) {
  const list = Array.isArray(codes)
    ? codes.map((value) => String(value).trim()).filter(Boolean)
    : [];

  if (!list.length) return {};
  const params = new URLSearchParams({ codes: list.join(',') });
  const out = await http(`${R.base}/cost-map?${params.toString()}`);
  return out?.data || {};
}

